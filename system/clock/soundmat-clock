#!/bin/sh
# SoundMat：开机时先等系统时钟校准，再让声音启动；之后这次开机不再校时
# （docs/implementation/DEPLOYMENT.md「时钟」）。
#
# 树莓派没有电池时钟，开机时用上次关机时存下的时间，联网校时会让时钟一下跳几分钟到几天。
# 合成器服务按墙钟时间执行带时间戳的指令，时钟在它运行时跳变会打乱定时（2026-10-18 在 Pi 3B 上
# 留下了停不下来的和声铺底）。所以：
#   有网：等到校准完成（通常开机后约 30 秒），最多等 MAX_WAIT 秒；
#   没网：开机 NO_NET_WAIT 秒后还没有任何网络连接（没有默认路由），不再等；
#   然后停掉 systemd-timesyncd：声音启动之后这次开机不再校时，时钟不会再跳。下次开机照常校时。
# 结论写进 STATUS（"synced <秒>" 或 "unsynced <秒>"），看板据此显示系统时间是否校准过。
MAX_WAIT=45
NO_NET_WAIT=20
STATUS=/run/soundmat-clock

synced() { [ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" = yes ]; }
online() { ip -4 route show default 2>/dev/null | grep -q . ; }

t=0
while [ "$t" -lt "$MAX_WAIT" ]; do
    synced && break
    if [ "$t" -ge "$NO_NET_WAIT" ] && ! online; then
        break
    fi
    sleep 1
    t=$((t + 1))
done

if synced; then
    echo "系统时钟已校准（开机后等了 ${t} 秒）"
    echo "synced $t" > "$STATUS"
else
    echo "系统时钟没有校准（等了 ${t} 秒），这次开机使用上次关机时存下的时间"
    echo "unsynced $t" > "$STATUS"
fi
chmod 644 "$STATUS"
systemctl stop systemd-timesyncd.service
exit 0
