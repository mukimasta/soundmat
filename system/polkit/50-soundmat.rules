// SoundMat：允许装置用户 soundmat 在控制台里重启声音（JACK 和合成器服务）、主机程序和整台机器
// （docs/implementation/DEPLOYMENT.md「组成」、soundmat/maintenance.py）。只放开这几项，其余仍按系统默认。
// 安装到 /etc/polkit-1/rules.d/50-soundmat.rules，polkit 会自动读取，不需要重启。
polkit.addRule(function (action, subject) {
    if (subject.user !== "soundmat") {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.id === "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        var verb = action.lookup("verb");
        var units = ["jackd.service", "soundmat-scsynth.service", "soundmat.service"];
        if (units.indexOf(unit) >= 0 && verb === "restart") {
            return polkit.Result.YES;
        }
    }
    if (action.id === "org.freedesktop.login1.reboot" ||
        action.id === "org.freedesktop.login1.reboot-multiple-sessions") {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
